<mvc:View
    controllerName="com.mahyhaker.hcmui.hcmui.controller.OrgTree"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="pageOrgTree"
        title="Organograma"
        showNavButton="true"
        navButtonPress="onNavBack"
        busy="{tree>/busy}"
        class="orgTreePage">

        <content>
            <VBox class="orgTreeContent">

                <Title
                    text="Estrutura Organizacional"
                    level="H2"
                    class="orgTreeTitle" />

                <MessageStrip
                    text="Visualize hierarquia, cargos, departamentos e subordinados diretos."
                    type="Information"
                    showIcon="true"
                    class="orgTreeStrip" />

                <HBox wrap="Wrap" class="orgTreeStats">
                    <GenericTile class="orgTreeStatTile" header="Colaboradores" subheader="Na estrutura" frameType="OneByHalf">
                        <TileContent>
                            <NumericContent value="{tree>/totalEmployees}" valueColor="Neutral" icon="sap-icon://employee" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile class="orgTreeStatTile" header="Liderancas" subheader="Com equipe direta" frameType="OneByHalf">
                        <TileContent>
                            <NumericContent value="{tree>/totalManagers}" valueColor="Good" icon="sap-icon://manager" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile class="orgTreeStatTile" header="Departamentos" subheader="Representados" frameType="OneByHalf">
                        <TileContent>
                            <NumericContent value="{tree>/totalDepartments}" valueColor="Neutral" icon="sap-icon://org-chart" />
                        </TileContent>
                    </GenericTile>
                </HBox>

                <Panel headerText="Hierarquia" class="orgTreePanel">
                    <content>
                        <OverflowToolbar class="orgTreeToolbar">
                            <SearchField
                                width="22rem"
                                placeholder="Buscar por nome, cargo, departamento ou PERNR"
                                search="onSearch"
                                liveChange="onSearch" />
                            <ToolbarSpacer />
                            <Button text="Expandir" icon="sap-icon://expand" press="onExpandAll" />
                            <Button text="Recolher" icon="sap-icon://collapse" press="onCollapseAll" />
                        </OverflowToolbar>

                        <Tree
                            id="orgTree"
                            class="orgTree"
                            mode="None"
                            noDataText="{tree>/noDataText}"
                            items="{
                                path: 'tree>/filteredNodes',
                                parameters: {
                                    arrayNames: ['children']
                                }
                            }">
                            <CustomTreeItem>
                                <HBox
                                    width="100%"
                                    justifyContent="SpaceBetween"
                                    alignItems="Center"
                                    wrap="Wrap"
                                    class="orgTreeNode">

                                    <HBox alignItems="Center" class="orgTreeNodeMain">
                                        <Avatar
                                            displayShape="Circle"
                                            initials="{path: 'tree>name', formatter: '.formatInitials'}"
                                            class="orgTreeAvatar" />
                                        <VBox class="orgTreeNodeText">
                                            <Link
                                                text="{tree>name}"
                                                press="onOpenEmployee"
                                                class="orgTreeNodeName" />
                                            <Text
                                                text="{= ${tree>position} || 'Cargo nao informado' }"
                                                class="orgTreeNodeRole" />
                                        </VBox>
                                    </HBox>

                                    <HBox alignItems="Center" justifyContent="End" wrap="Wrap" class="orgTreeNodeMeta">
                                        <ObjectStatus
                                            icon="sap-icon://org-chart"
                                            text="{= ${tree>department} ? ${tree>department} : 'Sem departamento' }"
                                            state="{= ${tree>department} ? 'Information' : 'Warning' }" />
                                        <ObjectStatus
                                            icon="sap-icon://group"
                                            text="{path: 'tree>children', formatter: '.formatReportsText'}"
                                            state="{path: 'tree>children', formatter: '.formatReportsState'}" />
                                        <ObjectIdentifier
                                            title="{tree>pernr}"
                                            text="PERNR" />
                                    </HBox>
                                </HBox>
                            </CustomTreeItem>
                        </Tree>
                    </content>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
