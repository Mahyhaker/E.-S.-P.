<mvc:View
    controllerName="com.mahyhaker.hcmui.hcmui.controller.Departments"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="pageDepartments"
        title="Departamentos"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="departmentsPage">

        <headerContent>
            <Button
                text="Adicionar"
                icon="sap-icon://add"
                type="Emphasized"
                press="onOpenCreateDepartmentDialog"
                visible="{session>/isAdmin}" />

            <Button
                text="Deletar"
                icon="sap-icon://delete"
                type="Negative"
                press="onDeleteDepartment"
                enabled="{= !!${departments>/selectedDepartment} &amp;&amp; ${departments>/selectedDepartment/canDelete} }"
                tooltip="{path: 'departments>/selectedDepartment/canDelete', formatter: '.formatDeleteTooltip'}"
                visible="{session>/isAdmin}" />
        </headerContent>

        <content>
            <VBox class="departmentsContent">

                <Title
                    text="Estrutura de Departamentos"
                    level="H2"
                    class="departmentsTitle" />

                <MessageStrip
                    text="Consulte departamentos, quantidade de colaboradores e areas vazias."
                    type="Information"
                    showIcon="true"
                    class="departmentsStrip" />

                <HBox wrap="Wrap" class="departmentsStats">
                    <GenericTile class="departmentsStatTile" header="Departamentos" subheader="Cadastrados" frameType="OneByHalf">
                        <TileContent>
                            <NumericContent value="{departments>/totalDepartments}" icon="sap-icon://org-chart" valueColor="Neutral" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile class="departmentsStatTile" header="Colaboradores" subheader="Com ou sem area" frameType="OneByHalf">
                        <TileContent>
                            <NumericContent value="{departments>/totalEmployees}" icon="sap-icon://employee" valueColor="Good" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile class="departmentsStatTile" header="Areas vazias" subheader="Sem colaboradores" frameType="OneByHalf">
                        <TileContent>
                            <NumericContent value="{departments>/emptyDepartments}" icon="sap-icon://alert" valueColor="{= ${departments>/emptyDepartments} > 0 ? 'Critical' : 'Good' }" />
                        </TileContent>
                    </GenericTile>
                </HBox>

                <Panel headerText="Departamentos cadastrados" class="departmentsPanel">
                    <content>
                        <OverflowToolbar class="departmentsToolbar">
                            <SearchField
                                width="22rem"
                                placeholder="Buscar por departamento, ID ou colaborador"
                                search="onSearch"
                                liveChange="onSearch" />
                            <ToolbarSpacer />
                            <ObjectStatus
                                text="{= ${departments>/filteredItems}.length + ' exibidos' }"
                                state="Information" />
                        </OverflowToolbar>

                        <List
                            id="departmentList"
                            class="departmentsList"
                            mode="{= ${session>/isAdmin} ? 'SingleSelectLeft' : 'None' }"
                            selectionChange="onDepartmentSelectionChange"
                            noDataText="{departments>/noDataText}"
                            items="{departments>/filteredItems}">
                            <items>
                                <ObjectListItem
                                    title="{departments>name}"
                                    intro="{= 'ID ' + ${departments>id} }"
                                    number="{departments>employeeCount}"
                                    numberUnit="colaboradores"
                                    numberState="{= ${departments>employeeCount} > 0 ? 'Success' : 'Warning' }">
                                    <attributes>
                                        <ObjectAttribute
                                            text="{= ${departments>employeesPreview} ? 'Equipe: ' + ${departments>employeesPreview} : 'Nenhum colaborador vinculado' }" />
                                    </attributes>
                                    <firstStatus>
                                        <ObjectStatus
                                            icon="{= ${departments>employeeCount} > 0 ? 'sap-icon://accept' : 'sap-icon://alert' }"
                                            text="{departments>statusText}"
                                            state="{departments>statusState}" />
                                    </firstStatus>
                                    <secondStatus>
                                        <ObjectStatus
                                            visible="{session>/isAdmin}"
                                            icon="{= ${departments>canDelete} ? 'sap-icon://delete' : 'sap-icon://locked' }"
                                            text="{= ${departments>canDelete} ? 'Pode deletar' : 'Protegido' }"
                                            state="{= ${departments>canDelete} ? 'None' : 'Information' }" />
                                    </secondStatus>
                                </ObjectListItem>
                            </items>
                        </List>
                    </content>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
