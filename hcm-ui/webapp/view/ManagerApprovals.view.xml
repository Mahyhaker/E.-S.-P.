<mvc:View
    controllerName="com.mahyhaker.hcmui.hcmui.controller.ManagerApprovals"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="pageManagerApprovals"
        title="Aprovar Solicitacoes"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="leavePage">

        <content>
            <VBox class="leaveContent">
                <Title text="Aprovacoes da Equipe" level="H2" class="leaveTitle" />

                <MessageStrip
                    text="Analise solicitacoes pendentes da equipe e registre a decisao."
                    type="Information"
                    showIcon="true"
                    class="leaveStrip" />

                <Panel headerText="Filtro" class="leavePanel">
                    <content>
                        <OverflowToolbar class="leaveToolbar">
                            <Select
                                id="selectManagerApproval"
                                width="22rem"
                                forceSelection="false"
                                selectedKey=""
                                change="onManagerChange"
                                enabled="{= ${session>/isAdmin} }"
                                items="{managers>/}">
                                <core:Item key="{managers>id}" text="{= ${managers>name} + ' - ' + ${managers>pernr} }" />
                            </Select>
                            <ToolbarSpacer />
                            <ObjectStatus text="{= ${approvalSummary>/pending} + ' pendentes' }" state="{= ${approvalSummary>/pending} > 0 ? 'Warning' : 'Success' }" />
                        </OverflowToolbar>
                    </content>
                </Panel>

                <Panel headerText="Solicitacoes pendentes" class="leavePanel">
                    <content>
                        <List class="leaveList" noDataText="Nenhuma solicitacao pendente encontrada." items="{pendingRequests>/}">
                            <items>
                                <CustomListItem>
                                    <VBox class="leaveDecisionCard">
                                        <HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap" class="leaveDecisionHeader">
                                            <VBox>
                                                <Title text="{= ${pendingRequests>employee/name} + ' - ' + ${pendingRequests>type} }" level="H5" />
                                                <Text text="{= 'Periodo: ' + ${pendingRequests>startDate} + ' ate ' + ${pendingRequests>endDate} }" />
                                            </VBox>
                                            <ObjectStatus text="Pendente" state="Warning" icon="sap-icon://pending" />
                                        </HBox>
                                        <Text text="{= 'Motivo: ' + ${pendingRequests>reason} }" class="leaveReasonText" />
                                        <HBox wrap="Wrap" class="leaveDecisionActions">
                                            <Button text="Aprovar" type="Accept" icon="sap-icon://accept" press="onApproveRequest" />
                                            <Button text="Rejeitar" type="Reject" icon="sap-icon://decline" press="onRejectRequest" />
                                        </HBox>
                                    </VBox>
                                </CustomListItem>
                            </items>
                        </List>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
