<mvc:View
    controllerName="com.mahyhaker.hcmui.hcmui.controller.LeaveRequests"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="pageLeaveRequests"
        title="Ausencias"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="leavePage">

        <headerContent>
            <Button
                text="Nova solicitacao"
                type="Emphasized"
                icon="sap-icon://add"
                press="onOpenCreateLeaveDialog" />
        </headerContent>

        <content>
            <VBox class="leaveContent">

                <Title text="Gestao de Ausencias" level="H2" class="leaveTitle" />

                <MessageStrip
                    text="Acompanhe solicitacoes, status e historico de ausencias."
                    type="Information"
                    showIcon="true"
                    class="leaveStrip" />

                <HBox wrap="Wrap" class="leaveStats">
                    <GenericTile class="leaveStatTile" header="Solicitacoes" subheader="Total" frameType="OneByHalf">
                        <TileContent><NumericContent value="{leaveSummary>/total}" icon="sap-icon://calendar" valueColor="Neutral" /></TileContent>
                    </GenericTile>
                    <GenericTile class="leaveStatTile" header="Pendentes" subheader="Aguardando decisao" frameType="OneByHalf">
                        <TileContent><NumericContent value="{leaveSummary>/pending}" icon="sap-icon://pending" valueColor="{= ${leaveSummary>/pending} > 0 ? 'Critical' : 'Good' }" /></TileContent>
                    </GenericTile>
                    <GenericTile class="leaveStatTile" header="Aprovadas" subheader="Liberadas" frameType="OneByHalf">
                        <TileContent><NumericContent value="{leaveSummary>/approved}" icon="sap-icon://accept" valueColor="Good" /></TileContent>
                    </GenericTile>
                    <GenericTile class="leaveStatTile" header="Rejeitadas" subheader="Negadas" frameType="OneByHalf">
                        <TileContent><NumericContent value="{leaveSummary>/rejected}" icon="sap-icon://decline" valueColor="Error" /></TileContent>
                    </GenericTile>
                </HBox>

                <Panel headerText="Filtros" class="leavePanel">
                    <content>
                        <OverflowToolbar class="leaveToolbar">
                            <Select
                                id="selectLeaveEmployee"
                                width="22rem"
                                forceSelection="false"
                                selectedKey=""
                                change="onEmployeeChange"
                                enabled="{= ${session>/isAdmin} || ${session>/isHr} }"
                                items="{employees>/}">
                                <core:Item key="{employees>id}" text="{= ${employees>name} + ' - ' + ${employees>pernr} }" />
                            </Select>

                            <Select
                                id="selectLeaveStatus"
                                width="14rem"
                                forceSelection="false"
                                selectedKey=""
                                change="onStatusFilterChange">
                                <core:Item key="" text="Todos os status" />
                                <core:Item key="PENDING" text="Pendentes" />
                                <core:Item key="APPROVED" text="Aprovadas" />
                                <core:Item key="REJECTED" text="Rejeitadas" />
                            </Select>

                            <ToolbarSpacer />
                            <ObjectStatus text="{= ${leaveSummary>/filtered} + ' exibidas' }" state="Information" />
                        </OverflowToolbar>
                    </content>
                </Panel>

                <Panel headerText="Solicitacoes registradas" class="leavePanel">
                    <content>
                        <List
                            class="leaveList"
                            noDataText="Nenhuma ausencia encontrada."
                            items="{leaveRequests>/}">
                            <items>
                                <ObjectListItem
                                    title="{path: 'leaveRequests>type', formatter: '.formatLeaveType'}"
                                    intro="{= ${leaveRequests>employee/name} || 'Funcionario' }"
                                    number="{path: 'leaveRequests>status', formatter: '.formatStatusText'}"
                                    numberState="{path: 'leaveRequests>status', formatter: '.formatStatusState'}">
                                    <attributes>
                                        <ObjectAttribute text="{= 'Periodo: ' + ${leaveRequests>startDate} + ' ate ' + ${leaveRequests>endDate} }" />
                                        <ObjectAttribute text="{= 'Motivo: ' + ${leaveRequests>reason} }" />
                                        <ObjectAttribute visible="{= !!${leaveRequests>approvedBy} }" text="{= 'Aprovado por: ' + ${leaveRequests>approvedBy} }" />
                                        <ObjectAttribute visible="{= !!${leaveRequests>rejectionReason} }" text="{= 'Justificativa: ' + ${leaveRequests>rejectionReason} }" />
                                    </attributes>
                                    <firstStatus>
                                        <ObjectStatus
                                            icon="{= ${leaveRequests>status} === 'APPROVED' ? 'sap-icon://accept' : (${leaveRequests>status} === 'REJECTED' ? 'sap-icon://decline' : 'sap-icon://pending') }"
                                            text="{path: 'leaveRequests>status', formatter: '.formatStatusText'}"
                                            state="{path: 'leaveRequests>status', formatter: '.formatStatusState'}" />
                                    </firstStatus>
                                </ObjectListItem>
                            </items>
                        </List>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
