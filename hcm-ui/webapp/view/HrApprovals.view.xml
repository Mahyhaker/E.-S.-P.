<mvc:View
    controllerName="com.mahyhaker.hcmui.hcmui.controller.HrApprovals"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="pageHrApprovals"
        title="Aprovacoes RH"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="leavePage">

        <content>
            <VBox class="leaveContent">
                <Title text="Aprovacoes do RH" level="H2" class="leaveTitle" />

                <MessageStrip
                    text="Acompanhe solicitacoes sem gerente direto e conclua a decisao pelo RH."
                    type="Information"
                    showIcon="true"
                    class="leaveStrip" />

                <HBox wrap="Wrap" class="leaveStats">
                    <GenericTile class="leaveStatTile" header="Pendentes RH" subheader="Aguardando decisao" frameType="OneByHalf">
                        <TileContent><NumericContent value="{hrSummary>/pending}" icon="sap-icon://group" valueColor="{= ${hrSummary>/pending} > 0 ? 'Critical' : 'Good' }" /></TileContent>
                    </GenericTile>
                </HBox>

                <Panel headerText="Solicitacoes aguardando RH" class="leavePanel">
                    <content>
                        <List class="leaveList" noDataText="Nenhuma solicitacao pendente para o RH." items="{hrRequests>/}">
                            <items>
                                <CustomListItem>
                                    <VBox class="leaveDecisionCard">
                                        <HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap" class="leaveDecisionHeader">
                                            <VBox>
                                                <Title text="{= ${hrRequests>employee/name} + ' - ' + ${hrRequests>type} }" level="H5" />
                                                <Text text="{= 'Periodo: ' + ${hrRequests>startDate} + ' ate ' + ${hrRequests>endDate} }" />
                                            </VBox>
                                            <ObjectStatus text="Pendente" state="Warning" icon="sap-icon://pending" />
                                        </HBox>
                                        <Text text="{= 'Motivo: ' + ${hrRequests>reason} }" class="leaveReasonText" />
                                        <HBox wrap="Wrap" class="leaveDecisionActions">
                                            <Button text="Aprovar" type="Accept" icon="sap-icon://accept" press="onApproveRequest" />
                                            <Button text="Rejeitar" type="Reject" icon="sap-icon://decline" press="onRejectRequest" />
                                        </HBox>
                                    </VBox>
                                </CustomListItem>
                            </items>
                        </List>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
