<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="createLeaveRequestDialog"
        title="Nova solicitacao de ausencia"
        contentWidth="32rem">
        <content>
            <VBox class="sapUiMediumMargin leaveDialogContent">
                <Label text="Data inicial" />
                <DatePicker
                    id="inputLeaveStartDate"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="dd/MM/yyyy"
                    placeholder="dd/mm/aaaa" />

                <Label text="Data final" class="sapUiSmallMarginTop" />
                <DatePicker
                    id="inputLeaveEndDate"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="dd/MM/yyyy"
                    placeholder="dd/mm/aaaa" />

                <Label text="Tipo" class="sapUiSmallMarginTop" />
                <Select id="selectLeaveType" selectedKey="">
                    <items>
                        <core:Item key="" text="Selecione" />
                        <core:Item key="VACATION" text="Ferias" />
                        <core:Item key="SICK_LEAVE" text="Atestado" />
                        <core:Item key="HOME_OFFICE" text="Home office" />
                        <core:Item key="PERSONAL" text="Pessoal" />
                    </items>
                </Select>

                <Label text="Motivo" class="sapUiSmallMarginTop" />
                <TextArea
                    id="inputLeaveReason"
                    rows="4"
                    growing="true"
                    placeholder="Descreva o motivo da solicitacao" />
            </VBox>
        </content>
        <beginButton>
            <Button text="Salvar" type="Emphasized" press="onCreateLeaveRequest" />
        </beginButton>
        <endButton>
            <Button text="Cancelar" press="onCloseCreateLeaveDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
