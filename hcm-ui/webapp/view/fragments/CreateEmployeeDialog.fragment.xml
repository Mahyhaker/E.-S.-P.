<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="createEmployeeDialog"
        title="Novo Funcionario"
        contentWidth="32rem">
        <content>
            <VBox class="sapUiMediumMargin employeeDialogContent">
                <MessageStrip
                    text="Crie o acesso e o vinculo operacional. Dados documentais serao mantidos pelo RH."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />

                <Label text="Nome de exibicao" />
                <Input id="inputName" placeholder="Nome usado no sistema" />

                <Label text="Cargo" class="sapUiSmallMarginTop" />
                <Input id="inputPosition" placeholder="Ex.: Desenvolvedor, Analista, Gerente" />

                <Label text="Salario" class="sapUiSmallMarginTop" />
                <Input id="inputSalary" type="Number" placeholder="0.00" />

                <Label text="Departamento" class="sapUiSmallMarginTop" />
                <ComboBox
                    id="selectDepartment"
                    selectedKey=""
                    placeholder="Sem departamento"
                    items="{departments>/}">
                    <core:Item key="{departments>id}" text="{departments>name}" />
                </ComboBox>

                <Label text="Gerente" class="sapUiSmallMarginTop" />
                <ComboBox
                    id="selectManager"
                    selectedKey=""
                    placeholder="Sem gerente"
                    items="{managers>/}">
                    <core:Item key="{managers>id}" text="{= ${managers>name} + ' - ' + ${managers>pernr} }" />
                </ComboBox>

                <Label text="Usuario" class="sapUiSmallMarginTop" />
                <Input id="inputUsername" placeholder="Login do colaborador" />

                <Label text="Senha" class="sapUiSmallMarginTop" />
                <Input id="inputPassword" type="Password" />

                <Label text="Perfil" class="sapUiSmallMarginTop" />
                <Select id="selectRole" selectedKey="">
                    <items>
                        <core:Item key="" text="Selecione" />
                        <core:Item key="EMPLOYEE" text="EMPLOYEE" />
                        <core:Item key="MANAGER" text="MANAGER" />
                        <core:Item key="HR" text="HR" />
                        <core:Item key="ADMIN" text="ADMIN" />
                    </items>
                </Select>
            </VBox>
        </content>
        <beginButton>
            <Button text="Salvar" type="Emphasized" press="onCreateEmployee" />
        </beginButton>
        <endButton>
            <Button text="Cancelar" press="onCloseCreateDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
